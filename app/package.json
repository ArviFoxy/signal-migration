{
  "name": "signal-migration-app",
  "private": true,
  "type": "module",
  "description": "Moves a user's data from Telegram into Signal, in the browser.",
  "scripts": {
    "generate": "buf generate",
    "build:wasm": "cd ../crates/signal-wasm && cargo build --release && wasm-bindgen --target web --out-dir ../../app/src/wasm target/wasm32-unknown-unknown/release/signal_migration_wasm.wasm",
    "build": "npm run generate && npm run build:wasm && node build.mjs",
    "check": "npm run generate && npm run build:wasm && tsc --noEmit",
    "test": "npm run generate && vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
